{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "southbound-web",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "southbound.realguesser.app",
      "custom_domain": true
    }
  ]
}
